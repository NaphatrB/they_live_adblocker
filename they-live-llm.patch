From ab607b5d2a78499d81bfa855c9f29b6bb7dfd481 Mon Sep 17 00:00:00 2001
From: Your Name <you@example.com>
Date: Fri, 29 May 2026 08:15:32 +0100
Subject: [PATCH 3/4] Show original ad on hover (peek-through)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

On mouse-over the they-live tile, the ::after slogan overlay is hidden
and the element background becomes transparent, revealing the real ad
content that was always in the DOM beneath the overlay.  Mouse-out
restores the OBEY/CONSUME/etc. tile instantly via pure CSS.

A faint rgba border remains during hover so the element boundary is
still visible.  No JS required — hover rules are appended to the same
injected stylesheet generated by theyLiveCss().

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>
---
 platform/mv3/extension/js/scripting/they-live.js | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/platform/mv3/extension/js/scripting/they-live.js b/platform/mv3/extension/js/scripting/they-live.js
index f77df0812..2445bdad0 100644
--- a/platform/mv3/extension/js/scripting/they-live.js
+++ b/platform/mv3/extension/js/scripting/they-live.js
@@ -124,7 +124,18 @@ self.theyLiveCss = function(selectorList) {
     const afterRule = `${afterSelectors} {
     content: attr(${ATTR});${AFTER_STYLE}
 }`;
-    return `${maskRule}\n${afterRule}\n`;
+    // Hover: hide the overlay and reveal the original ad beneath.
+    const hoverSelectors = selectors.map(s => `${s}:hover`).join(',\n');
+    const hoverAfterSelectors = selectors.map(s => `${s}:hover::after`).join(',\n');
+    const hoverRule = `${hoverSelectors} {
+    background: transparent !important;
+    border-color: rgba(0,0,0,0.2) !important;
+    overflow: visible !important;
+}
+${hoverAfterSelectors} {
+    display: none !important;
+}`;
+    return `${maskRule}\n${afterRule}\n${hoverRule}\n`;
 };
 
